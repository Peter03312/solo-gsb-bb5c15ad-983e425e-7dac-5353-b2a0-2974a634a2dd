# ===== 数据库连接（一般无需修改，Compose 已自动注入）=====
# DATABASE_URL=postgresql+psycopg://calib:calib@db:5432/calibration

# ===== PostgreSQL 容器初始化账号/库（仅首次创建数据卷时生效）=====
POSTGRES_USER=calib
POSTGRES_PASSWORD=calib
POSTGRES_DB=calibration

# ===== 服务端口（宿主机映射端口，容器内固定 8080）=====
APP_PORT=8080

# ===== 追溯链最大深度 =====
MAX_CHAIN_DEPTH=100

# ===== 可串行化冲突/死锁时的事务重试次数 =====
TX_MAX_ATTEMPTS=8
